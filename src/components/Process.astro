---
import Icon from './Icon.astro';

const steps = [
  { title: 'Objednání', text: 'Zavoláte nebo vyplníte formulář. Domluvíme termín, který vám vyhovuje.' },
  { title: 'Diagnostika', text: 'Vůz prohlédneme a zjistíme skutečnou příčinu problému.' },
  { title: 'Schválení', text: 'Řekneme vám rozsah i cenu. Bez vašeho souhlasu nic neopravujeme.' },
  { title: 'Předání', text: 'Vysvětlíme, co jsme udělali, a předáme vám auto připravené na cestu.' },
];
---

<section class="relative overflow-hidden bg-ink-900 py-24 lg:py-28" aria-labelledby="postup-title">
  <div class="container-site">
    <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
      <div>
        <p class="eyebrow" data-reveal>Jak to u nás funguje</p>
        <h2 id="postup-title" class="mt-5 text-[clamp(2rem,4vw,3.25rem)]" data-reveal style="--reveal-delay: 80">
          Čtyři kroky. <span class="text-brand-500">Žádná překvapení.</span>
        </h2>
      </div>
      <a href="#objednat" class="btn btn-ghost self-start md:self-auto" data-reveal style="--reveal-delay: 150">
        Objednat termín <Icon name="arrow" class="arrow" />
      </a>
    </div>

    <ol class="relative mt-14 grid gap-10 md:grid-cols-4 md:gap-6 lg:mt-16">
      <span class="absolute top-[1.375rem] right-0 left-0 hidden h-px bg-white/10 md:block" aria-hidden="true"></span>
      {
        steps.map((s, i) => (
          <li class="relative" data-reveal style={`--reveal-delay: ${i * 110}`}>
            <span class="relative inline-flex size-11 items-center justify-center border border-brand-500 bg-ink-900 font-display text-lg font-semibold text-white tabular-nums">
              {i + 1}
            </span>
            <h3 class="mt-6 text-2xl">{s.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-steel-300">{s.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
