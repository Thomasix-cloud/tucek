---
import { site, fullAddress } from '../config/site';
import { SERVICE_OPTIONS } from '../lib/booking/shared';
import Icon from './Icon.astro';
---

<section id="kontakt" class="relative overflow-hidden bg-ink-900 py-24 lg:py-32" aria-labelledby="kontakt-title">
  <div class="bg-grid pointer-events-none absolute inset-0 opacity-50 [mask-image:radial-gradient(ellipse_at_top_left,black,transparent_70%)]" aria-hidden="true"></div>

  <div class="container-site relative grid gap-16 lg:grid-cols-12 lg:gap-12">
    <!-- Kontaktní údaje -->
    <div class="lg:col-span-5">
      <p class="eyebrow" data-reveal><span class="text-steel-400 tabular-nums">06</span>Kontakt</p>
      <h2 id="kontakt-title" class="h-section mt-5" data-reveal style="--reveal-delay: 80">
        Objednejte se.
        <br /><span class="text-brand-500">Zbytek je na nás.</span>
      </h2>
      <p class="lead mt-6 max-w-md" data-reveal style="--reveal-delay: 150">
        Nejrychleji nás zastihnete telefonicky. Můžete také vyplnit krátký formulář a my se vám ozveme.
      </p>

      <div class="mt-10 grid gap-px bg-white/10" data-reveal style="--reveal-delay: 200">
        <div class="bg-ink-900 py-6">
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-steel-400">Telefon</p>
          <div class="mt-3 grid gap-1">
            {
              site.phones.map((p) => (
                <a href={p.href} class="group inline-flex items-center gap-3 font-display text-3xl font-semibold text-white sm:text-4xl">
                  {p.display}
                  <Icon name="arrow-up-right" size={22} class="text-brand-500 transition-transform group-hover:translate-x-1 group-hover:-translate-y-1" />
                </a>
              ))
            }
          </div>
        </div>
        {
          site.email && (
            <div class="bg-ink-900 py-6">
              <p class="text-xs font-semibold uppercase tracking-[0.18em] text-steel-400">E-mail</p>
              <a href={`mailto:${site.email}`} class="mt-2 inline-block text-lg text-white hover:text-brand-400">{site.email}</a>
            </div>
          )
        }
        <div class="grid gap-6 bg-ink-900 py-6 sm:grid-cols-2">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-steel-400">Provozovna</p>
            <address class="mt-2 not-italic leading-relaxed text-white">
              {site.address.street}<br />{site.address.zip} {site.address.city}
            </address>
            <div class="mt-1 flex flex-wrap gap-x-5 text-sm">
              <a href={site.maps.google} target="_blank" rel="noopener" class="inline-block py-2 text-brand-400 underline-offset-4 hover:underline">Google Maps</a>
              <a href={site.maps.mapy} target="_blank" rel="noopener" class="inline-block py-2 text-brand-400 underline-offset-4 hover:underline">Mapy.com</a>
            </div>
          </div>
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-steel-400">Otevírací doba</p>
            <dl class="mt-2 grid gap-1 text-white">
              {
                site.hours.map((h) => (
                  <div class="flex justify-between gap-4">
                    <dt class="text-steel-300">{h.days}</dt>
                    <dd>{h.time}</dd>
                  </div>
                ))
              }
            </dl>
          </div>
        </div>
      </div>

      <!-- Mapa: načte se až po kliknutí (rychlost + soukromí) -->
      <div class="relative mt-8 aspect-[16/10] overflow-hidden border border-white/10 bg-ink-850" data-map data-src={site.maps.embed} data-reveal style="--reveal-delay: 250">
        <div class="bg-grid absolute inset-0" aria-hidden="true"></div>
        <svg class="absolute inset-0 h-full w-full text-white/10" aria-hidden="true" preserveAspectRatio="none" viewBox="0 0 400 250" fill="none" stroke="currentColor">
          <path d="M-10 180 C80 160 120 90 210 110 S330 60 410 40" stroke-width="10" />
          <path d="M60 -10 C90 80 150 140 160 260" stroke-width="5" />
          <path d="M250 260 C260 190 300 150 410 150" stroke-width="5" />
        </svg>
        <div class="absolute inset-0 flex flex-col items-center justify-center gap-4 p-6 text-center">
          <span class="relative inline-flex size-14 items-center justify-center bg-brand text-white">
            <Icon name="pin" size={28} />
            <span class="absolute inset-0 motion-safe:animate-ping bg-brand/40" aria-hidden="true"></span>
          </span>
          <p class="text-sm text-steel-200">{fullAddress}</p>
          <button type="button" class="btn btn-ghost min-h-11 text-sm" data-map-load>
            Zobrazit mapu
          </button>
          <p class="max-w-xs text-xs text-steel-400">Po kliknutí se načte mapa Google, která může ukládat cookies.</p>
        </div>
      </div>
    </div>

    <!-- Objednávkový formulář -->
    <div class="lg:col-span-7 lg:pl-8" id="objednat">
      <div class="relative border border-white/10 bg-ink-950/80 p-6 sm:p-10" data-reveal style="--reveal-delay: 120">
        <span class="absolute -top-px left-0 h-0.5 w-24 bg-brand-500" aria-hidden="true"></span>
        <h3 class="text-4xl sm:text-5xl">Objednat do servisu</h3>
        <p class="mt-3 text-sm text-steel-300">Vyplnění zabere minutu. Termín vám potvrdíme telefonicky nebo e-mailem.</p>

        <form action="/api/booking" method="post" class="mt-8 grid gap-5 sm:grid-cols-2" data-booking-form novalidate>
          <div>
            <label for="f-name" class="field-label">Jméno a příjmení *</label>
            <input id="f-name" name="name" type="text" required minlength="2" maxlength="100" autocomplete="name" class="field" aria-describedby="e-name" />
            <p id="e-name" class="mt-1.5 hidden text-sm text-brand-400" data-error="name"></p>
          </div>
          <div>
            <label for="f-contact" class="field-label">Telefon nebo e-mail *</label>
            <input id="f-contact" name="contact" type="text" required maxlength="120" autocomplete="tel" inputmode="text" class="field" aria-describedby="e-contact" />
            <p id="e-contact" class="mt-1.5 hidden text-sm text-brand-400" data-error="contact"></p>
          </div>
          <div>
            <label for="f-car" class="field-label">Značka a model vozu *</label>
            <input id="f-car" name="car" type="text" required minlength="2" maxlength="120" placeholder="např. BMW 320d, Škoda Octavia" class="field" aria-describedby="e-car" />
            <p id="e-car" class="mt-1.5 hidden text-sm text-brand-400" data-error="car"></p>
          </div>
          <div>
            <label for="f-service" class="field-label">Služba</label>
            <div class="relative">
              <select id="f-service" name="service" class="field appearance-none pr-10">
                <option value="">Vyberte službu</option>
                {SERVICE_OPTIONS.map((o) => <option value={o}>{o}</option>)}
              </select>
              <Icon name="chevron" size={18} class="pointer-events-none absolute top-1/2 right-4 -translate-y-1/2 rotate-90 text-steel-400" />
            </div>
          </div>
          <div class="sm:col-span-2">
            <label for="f-message" class="field-label">Požadavek nebo popis problému *</label>
            <textarea id="f-message" name="message" rows="4" required minlength="5" maxlength="2000" class="field resize-y" placeholder="Co je potřeba udělat? Jak se závada projevuje?" aria-describedby="e-message"></textarea>
            <p id="e-message" class="mt-1.5 hidden text-sm text-brand-400" data-error="message"></p>
          </div>
          <div>
            <label for="f-date" class="field-label">Preferovaný termín</label>
            <input id="f-date" name="preferredDate" type="date" class="field [color-scheme:dark]" />
          </div>
          <!-- Honeypot – skryté pro lidi -->
          <div class="absolute -left-[9999px] h-px w-px overflow-hidden" aria-hidden="true">
            <label for="f-website">Web</label>
            <input id="f-website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>
          <div class="flex items-end">
            <button type="submit" class="btn btn-primary w-full" data-submit>
              <span data-submit-label>Objednat do servisu</span>
              <Icon name="arrow" class="arrow" />
            </button>
          </div>

          <p class="text-xs leading-relaxed text-steel-400 sm:col-span-2">
            Odesláním formuláře berete na vědomí
            <a href="/ochrana-osobnich-udaju" class="underline underline-offset-2 hover:text-white">zpracování osobních údajů</a>
            za účelem vyřízení objednávky.
          </p>

          <div class="hidden sm:col-span-2" data-status role="status" aria-live="polite"></div>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  import { isEmail, isPhone } from '../lib/booking/shared';

  // --- Mapa po kliknutí ---
  document.querySelectorAll<HTMLElement>('[data-map]').forEach((wrap) => {
    wrap.querySelector('[data-map-load]')?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = wrap.dataset.src!;
      iframe.title = 'Mapa – Autoservis Petr Tuček, Malešovice 113';
      iframe.loading = 'lazy';
      iframe.referrerPolicy = 'no-referrer-when-downgrade';
      iframe.className = 'absolute inset-0 h-full w-full border-0 grayscale invert-[0.9] hue-rotate-180 contrast-[0.9]';
      wrap.replaceChildren(iframe);
    });
  });

  // --- Objednávkový formulář ---
  const dateInput = document.querySelector<HTMLInputElement>('#f-date');
  if (dateInput) dateInput.min = new Date().toISOString().slice(0, 10);

  const form = document.querySelector<HTMLFormElement>('[data-booking-form]');
  if (form) {
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const label = form.querySelector<HTMLElement>('[data-submit-label]')!;
    const phone = document.querySelector<HTMLAnchorElement>('a[href^="tel:"]');
    const phoneHtml = phone ? `<a href="${phone.href}" class="font-semibold text-white underline underline-offset-4">${phone.textContent?.trim()}</a>` : 'telefonicky';

    const setError = (name: string, msg?: string) => {
      const el = form.querySelector<HTMLElement>(`[data-error="${name}"]`);
      const input = form.elements.namedItem(name) as HTMLInputElement | null;
      if (el) {
        el.textContent = msg ?? '';
        el.classList.toggle('hidden', !msg);
      }
      if (input) {
        input.setAttribute('aria-invalid', msg ? 'true' : 'false');
        input.classList.toggle('!border-brand-500', Boolean(msg));
      }
    };

    const showStatus = (kind: 'success' | 'warning' | 'error', html: string) => {
      const styles = {
        success: 'border-emerald-500/40 bg-emerald-500/10',
        warning: 'border-amber-400/40 bg-amber-400/10',
        error: 'border-brand-500/50 bg-brand/15',
      };
      status.className = `border p-5 text-sm leading-relaxed text-steel-100 sm:col-span-2 ${styles[kind]}`;
      status.innerHTML = html;
    };

    const validate = () => {
      const v = (n: string) => ((form.elements.namedItem(n) as HTMLInputElement).value || '').trim();
      const errors: Record<string, string> = {};
      if (v('name').length < 2) errors.name = 'Vyplňte prosím jméno.';
      const c = v('contact');
      if (!c) errors.contact = 'Zadejte telefon nebo e-mail.';
      else if (!isEmail(c) && !isPhone(c)) errors.contact = 'Zadejte platný telefon nebo e-mail.';
      if (v('car').length < 2) errors.car = 'Uveďte značku a model vozu.';
      if (v('message').length < 5) errors.message = 'Popište prosím, s čím potřebujete pomoci.';
      ['name', 'contact', 'car', 'message'].forEach((n) => setError(n, errors[n]));
      return errors;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const errors = validate();
      const first = Object.keys(errors)[0];
      if (first) {
        (form.elements.namedItem(first) as HTMLElement).focus();
        return;
      }

      submit.disabled = true;
      label.textContent = 'Odesílám…';
      status.classList.add('hidden');

      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { 'content-type': 'application/json', accept: 'application/json' },
          body: JSON.stringify(Object.fromEntries(new FormData(form).entries())),
        });
        const data = await res.json().catch(() => ({}));

        if (res.ok && data.ok) {
          form.reset();
          showStatus('success', `<strong class="text-white">Děkujeme, objednávku jsme přijali.</strong> Ozveme se vám co nejdříve a termín potvrdíme. Číslo požadavku: <strong class="text-white">${data.reference}</strong>.`);
        } else if (data.error === 'validation' && data.fields) {
          Object.entries(data.fields as Record<string, string>).forEach(([k, m]) => setError(k, m));
        } else if (data.error === 'not_configured') {
          showStatus('warning', `<strong class="text-white">Online objednávky zatím nejsou aktivní.</strong> Odesílání formuláře ještě vyžaduje konfiguraci. Objednejte se prosím telefonicky na ${phoneHtml}.`);
        } else if (data.error === 'rate_limited') {
          showStatus('error', `Odeslali jste příliš mnoho požadavků. Zkuste to prosím za chvíli, nebo volejte ${phoneHtml}.`);
        } else {
          showStatus('error', `<strong class="text-white">Objednávku se nepodařilo odeslat.</strong> Zkuste to prosím znovu, nebo nám zavolejte na ${phoneHtml}.`);
        }
      } catch {
        showStatus('error', `<strong class="text-white">Nepodařilo se spojit se serverem.</strong> Zkontrolujte připojení, nebo nám zavolejte na ${phoneHtml}.`);
      } finally {
        submit.disabled = false;
        label.textContent = 'Objednat do servisu';
      }
    });

    form.addEventListener('input', (e) => {
      const t = e.target as HTMLInputElement;
      if (t.getAttribute('aria-invalid') === 'true') setError(t.name, undefined);
    });
  }
</script>
