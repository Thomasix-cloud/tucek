---
import { reviews } from '../data/reviews';
import { site } from '../config/site';
import Icon from './Icon.astro';

const hasReviews = reviews.length > 0;
// Na produkci sekci bez recenzí skryjeme; ve vývoji ukážeme připravený stav.
const show = hasReviews || import.meta.env.DEV;
const avg = hasReviews ? reviews.reduce((s, r) => s + r.rating, 0) / reviews.length : 0;
const fmtDate = (d?: string) => (d ? new Date(d).toLocaleDateString('cs-CZ', { month: 'long', year: 'numeric' }) : '');
---

{
  show && (
    <section id="reference" class="relative bg-ink-900 py-24 lg:py-32" aria-labelledby="ref-title">
      <div class="container-site">
        <div class="flex flex-col justify-between gap-8 lg:flex-row lg:items-end">
          <div>
            <p class="eyebrow" data-reveal>Reference</p>
            <h2 id="ref-title" class="h-section mt-5" data-reveal style="--reveal-delay: 80">
              Co říkají
              <br />
              <span class="text-brand-500">naši zákazníci.</span>
            </h2>
          </div>
          {hasReviews && (
            <p class="flex items-center gap-4" data-reveal>
              <span class="font-display text-6xl font-bold text-white">{avg.toLocaleString('cs-CZ', { maximumFractionDigits: 1 })}</span>
              <span class="text-sm text-steel-300">
                průměrné hodnocení
                <br />z {reviews.length} recenzí
              </span>
            </p>
          )}
        </div>

        {hasReviews ? (
          <ul class="mt-14 grid gap-3 md:grid-cols-2 lg:mt-20 lg:grid-cols-3">
            {reviews.map((r, i) => (
              <li class="flex flex-col border border-white/10 bg-ink-850 p-8" data-reveal style={`--reveal-delay: ${i * 80}`}>
                <div class="flex gap-1 text-brand-500" aria-label={`Hodnocení ${r.rating} z 5`} role="img">
                  {Array.from({ length: 5 }, (_, k) => (
                    <Icon name="star" size={18} class:list={[k < r.rating ? 'fill-current' : 'opacity-30']} />
                  ))}
                </div>
                <blockquote class="mt-6 flex-1 leading-relaxed text-steel-100">„{r.text}“</blockquote>
                <p class="mt-8 border-t border-white/10 pt-5 text-sm">
                  <span class="font-semibold text-white">{r.author}</span>
                  <span class="text-steel-400">
                    {r.source && ` · ${r.source}`}
                    {r.date && ` · ${fmtDate(r.date)}`}
                  </span>
                </p>
              </li>
            ))}
          </ul>
        ) : (
          <div class="mt-14 border border-dashed border-white/20 p-10 text-center lg:mt-20" data-reveal>
            <p class="font-display text-sm font-semibold uppercase tracking-[0.2em] text-brand-400">Připraveno k doplnění</p>
            <p class="mx-auto mt-4 max-w-xl text-steel-300">
              Sem patří skutečné recenze zákazníků (např. z Google profilu). Doplňte je do
              <code class="text-white">src/data/reviews.ts</code>. Dokud je seznam prázdný, sekce se na produkčním webu nezobrazí.
            </p>
          </div>
        )}

        {site.social.google && (
          <div class="mt-10 flex justify-center">
            <a href={site.social.google} target="_blank" rel="noopener" class="btn btn-ghost">
              <Icon name="google" /> Ohodnoťte nás na Google
            </a>
          </div>
        )}
      </div>
    </section>
  )
}
