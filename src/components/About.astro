---
import { Image } from 'astro:assets';
import workshop from '../assets/placeholder/dilna-tma.jpg';
import detail from '../assets/placeholder/mechanik-prace.jpg';
import { site } from '../config/site';
import Icon from './Icon.astro';
---

<section id="o-nas" class="relative overflow-hidden bg-ink-950 py-24 lg:py-32" aria-labelledby="onas-title">
  <div class="container-site grid items-center gap-14 lg:grid-cols-12 lg:gap-12">
    <div class="relative lg:col-span-7">
      <div class="crop-marks aspect-[4/3] sm:aspect-[16/11]" data-reveal="clip">
        <Image
          src={workshop}
          alt="Interiér dílny s vozem připraveným k servisu"
          widths={[640, 960, 1280, 1600]}
          sizes="(min-width: 1024px) 58vw, 100vw"
          quality={65}
          class="h-full w-full object-cover"
        />
      </div>
      <div
        class="absolute -bottom-10 -right-2 hidden aspect-[3/4] w-[34%] border-[6px] border-ink-950 sm:block lg:-right-10"
        data-reveal
        style="--reveal-delay: 250"
      >
        <Image
          src={detail}
          alt="Mechanik při práci v motorovém prostoru"
          widths={[320, 480, 640]}
          sizes="(min-width: 1024px) 20vw, 34vw"
          quality={65}
          class="h-full w-full object-cover"
        />
      </div>
    </div>

    <div class="lg:col-span-5 lg:pl-8">
      <p class="eyebrow" data-reveal><span class="text-steel-400 tabular-nums">04</span>Náš autoservis</p>
      <h2 id="onas-title" class="h-section mt-5" data-reveal style="--reveal-delay: 80">
        Dílna v Malešovicích.
        <br /><span class="text-brand-500">Za ní konkrétní lidé.</span>
      </h2>
      <!-- TODO: nahradit skutečným příběhem / představením týmu od klienta -->
      <div class="mt-8 grid gap-5 leading-relaxed text-steel-200" data-reveal style="--reveal-delay: 150">
        <p>
          Autoservis Petr Tuček najdete v Malešovicích, kousek od Brna a Pohořelic. Staráme se o osobní automobily všech
          značek a nejvíc zkušeností máme s vozy BMW a koncernu VW.
        </p>
        <p>
          Zakládáme si na poctivé práci a otevřené domluvě. Každé auto, které k nám přijede, bereme, jako by bylo naše.
        </p>
      </div>

      <ul class="mt-10 grid gap-4 border-t border-white/10 pt-8 text-sm" data-reveal style="--reveal-delay: 220">
        <li class="flex items-start gap-4">
          <Icon name="pin" class="mt-0.5 shrink-0 text-brand-500" />
          <span><span class="text-steel-400">Provozovna:</span> <span class="text-white">{site.address.street}, {site.address.zip} {site.address.city}</span></span>
        </li>
        <li class="flex items-start gap-4">
          <Icon name="shield" class="mt-0.5 shrink-0 text-brand-500" />
          <span><span class="text-steel-400">Provozovatel:</span> <span class="text-white">{site.legalName}</span></span>
        </li>
      </ul>
    </div>
  </div>
</section>
