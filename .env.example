# Finální doména webu (canonical URL, sitemap, Open Graph). Bez lomítka na konci.
PUBLIC_SITE_URL=https://www.autoservis-tucek.cz

# Objednávkový formulář – Resend (https://resend.com)
# Dokud nejsou vyplněné, formulář zobrazí „Online objednávky zatím nejsou aktivní“.
BOOKING_PROVIDER=resend
RESEND_API_KEY=
# Kam chodí objednávky (více adres oddělte čárkou)
BOOKING_TO_EMAIL=
# Odesílatel – musí být z domény ověřené v Resendu, např. "Web Autoservis Tuček <web@autoservis-tucek.cz>"
BOOKING_FROM_EMAIL=
# Posílat zákazníkovi potvrzovací e-mail (pokud zadal e-mail)
BOOKING_SEND_CONFIRMATION=true
